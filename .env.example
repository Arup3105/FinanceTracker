# Copy to .env.local for local development (never commit real values).
# In Vercel, add the same variables under Project → Settings → Environment Variables.

# MongoDB Atlas connection string (Atlas → Connect → Drivers). URL-encode special characters in the password.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=finance-tracker"
# Database name used by the app.
MONGODB_DB_NAME="finance"

# Better Auth: secret used to sign session cookies (min. 32 chars). Generate: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
# Public base URL of the app. Local: http://localhost:3000 · Production: https://<your-app>.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
