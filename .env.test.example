# Copy to .env.test.local to run the integration tests (never commit real values).
# Use a SEPARATE database: the tests delete all documents in it before running.
MONGODB_URI_TEST="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
# Must contain "test" (safety check). Defaults to finance_test.
MONGODB_DB_NAME_TEST="finance_test"
